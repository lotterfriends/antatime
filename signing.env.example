# Lokale Release-Signatur für scripts/build_android.sh.
#
#   cp signing.env.example signing.env   # signing.env wird nicht eingecheckt
#
# Dieselben Werte wie die Repository-Secrets ANDROID_* in GitHub. Die lassen
# sich dort nicht auslesen – Keystore und Passwörter aus der eigenen Ablage
# (z. B. Passwortmanager) nehmen. Die .jks-Datei außerhalb des Repos ablegen
# oder hier im Projekt (*.jks ist ebenfalls ignoriert). Passwörter mit
# Sonderzeichen in einfache Anführungszeichen setzen: 'pa$$wort'.

# Pfad zur Keystore-Datei (alternativ ANDROID_KEYSTORE_BASE64 wie in CI)
ANDROID_KEYSTORE_FILE=~/keys/antatime-release.jks
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=
